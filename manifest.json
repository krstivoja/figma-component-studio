{
  "name": "Component Studio",
  "id": "component-studio",
  "api": "1.0.0",
  "main": "dist/code.js",
  "ui": "dist/ui.html",
  "editorType": ["figma"],
  "relaunchButtons": [
    { "command": "open", "name": "Open Component Studio" },
    { "command": "check", "name": "Check with Component Studio" }
  ],
  "permissions": ["teamlibrary"],
  "networkAccess": {
    "allowedDomains": ["ws://localhost:9240"],
    "devAllowedDomains": ["ws://localhost:9240"],
    "reasoning": "Connects to the local Component Studio MCP server so Claude Code can read the selected component and propose names and tokens."
  }
}
